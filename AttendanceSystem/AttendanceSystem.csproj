<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Fail closed on moderate/serious transitive NuGet advisories and audit outages.
         Do NOT suppress advisories for production. Legacy provider v2 migration is separate. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>
  </PropertyGroup>

  <!-- Pinned dependencies. Review the existing vendor DLLs before any redistributable release. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NodaTime" Version="3.2.0" />
    <!-- ADO.NET provider only: the meta-package adds unused EF6 + transitive vulnerabilities. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- Twilio SDK intentionally omitted. v0.6.0 transports only synthetic dry-runs. -->
    <PackageReference Include="Zmanim" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AdminUi/index.html" />
    <EmbeddedResource Include="AdminUi/style.css" />
    <EmbeddedResource Include="AdminUi/app.js" />
  </ItemGroup>

  <!-- ASP.NET Core Kestrel from the .NET shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Legacy SDK references now resolve within the checkout, not a developer's Downloads folder. -->
  <!-- Legacy SDK binary licensing / .NET 10 runtime compatibility are NOT yet verified. -->
  <ItemGroup>
    <Reference Include="log4net">
      <HintPath>Dependancies/log4net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SuperSocket.Common">
      <HintPath>Dependancies/SuperSocket.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SuperSocket.SocketBase">
      <HintPath>Dependancies/SuperSocket.SocketBase.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SuperSocket.SocketEngine">
      <HintPath>Dependancies/SuperSocket.SocketEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SuperSocket.WebSocket">
      <HintPath>Dependancies/SuperSocket.WebSocket.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateCheckedInLegacySdkFiles" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Dependancies/SuperSocket.Common.dll')"
           Text="Missing checked-in legacy SDK dependencies; consult docs/SDK_COMPATIBILITY.md." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Dependancies/SuperSocket.SocketBase.dll')"
           Text="Missing checked-in legacy SDK dependencies; consult docs/SDK_COMPATIBILITY.md." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Dependancies/SuperSocket.SocketEngine.dll')"
           Text="Missing checked-in legacy SDK dependencies; consult docs/SDK_COMPATIBILITY.md." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Dependancies/SuperSocket.WebSocket.dll')"
           Text="Missing checked-in legacy SDK dependencies; consult docs/SDK_COMPATIBILITY.md." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Dependancies/log4net.dll')"
           Text="Missing checked-in legacy SDK dependencies; consult docs/SDK_COMPATIBILITY.md." />
  </Target>
</Project>
